<mvc:View
    controllerName="apps.dflc.benditalook.controller.Product"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="productPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <FlexBox
                wrap="Wrap"
                alignItems="Start"
                justifyContent="Center"
                visible="{product>/loaded}"
                class="blContainer blProductDetail"
            >
                <VBox class="blGallery">
                    <Carousel
                        id="productCarousel"
                        height="auto"
                        pages="{path: 'product>/images', templateShareable: false}"
                        visible="{= ${product>/images}.length > 0 }"
                        showPageIndicator="{= ${product>/images}.length > 1 }"
                        class="blCarousel"
                    >
                        <Image
                            src="{path: 'product>ID', formatter: '.formatter.catalogImageUrl'}"
                            alt="{product>/product/Name}"
                            width="100%"
                            densityAware="false"
                            class="blDetailImage"
                        />
                    </Carousel>
                    <Image
                        src="img/placeholder.svg"
                        width="100%"
                        visible="{= ${product>/images}.length === 0 }"
                        class="blDetailImage"
                    />
                </VBox>

                <VBox class="blDetailInfo">
                    <Text text="{product>/product/Category/Name}" class="blCategoryLabel" />
                    <Title text="{product>/product/Name}" level="H1" titleStyle="H2" wrapping="true" />
                    <Text
                        text="{path: 'product>/product/Price', targetType: 'any', formatter: '.formatter.currency'}"
                        class="blDetailPrice sapUiSmallMarginTopBottom"
                    />
                    <Text text="{product>/product/Description}" class="sapUiSmallMarginBottom" />

                    <VBox visible="{= ${product>/colors}.length > 0 }" class="sapUiSmallMarginTop">
                        <Label text="{i18n>color}" design="Bold" />
                        <SegmentedButton
                            selectedKey="{product>/selectedColorId}"
                            items="{path: 'product>/colors', templateShareable: false}"
                            selectionChange=".onColorChange"
                            class="blSelector"
                        >
                            <items>
                                <SegmentedButtonItem key="{product>ID}" text="{product>Name}" />
                            </items>
                        </SegmentedButton>
                    </VBox>

                    <VBox class="sapUiSmallMarginTop">
                        <Label text="{i18n>size}" design="Bold" />
                        <SegmentedButton
                            selectedKey="{product>/selectedVariantId}"
                            items="{path: 'product>/sizes', templateShareable: false}"
                            selectionChange=".onSizeChange"
                            class="blSelector"
                        >
                            <items>
                                <SegmentedButtonItem key="{product>key}" text="{product>text}" enabled="{product>enabled}" />
                            </items>
                        </SegmentedButton>
                        <ObjectStatus
                            text="{parts: ['i18n>inStock', 'i18n>soldOut', 'product>/stock'], formatter: '.formatter.stockMessage'}"
                            state="{= ${product>/stock} > 0 ? 'Success' : 'Error' }"
                            class="sapUiTinyMarginTop"
                        />
                    </VBox>

                    <HBox alignItems="End" class="sapUiMediumMarginTop blBuyBox">
                        <VBox class="sapUiSmallMarginEnd">
                            <Label text="{i18n>quantity}" design="Bold" />
                            <StepInput
                                value="{product>/quantity}"
                                min="1"
                                max="{= Math.max(${product>/stock}, 1) }"
                                enabled="{= ${product>/stock} > 0 }"
                                width="8rem"
                            />
                        </VBox>
                        <Button
                            text="{i18n>addToCart}"
                            icon="sap-icon://cart-4"
                            type="Emphasized"
                            enabled="{= ${product>/stock} > 0 }"
                            press=".onAddToCart"
                            class="blPrimaryButton"
                        />
                    </HBox>
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
